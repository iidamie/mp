#!name=YouTube 强制显示试用付款页面
#!desc=YouTube 强制显示试用付款页面
#!category=YouTube

[Script]
youtube-request = type=http-request,pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse,script-path=https://raw.githubusercontent.com/iidamie/mp/refs/heads/main/youtube/request_trial.js,requires-body=1,max-size=0,binary-body-mode=0,timeout=90,script-update-interval=28800

youtube-response = type=http-response,pattern=^https?:\/\/youtubei\.idamie\.com\/youtubei\/v1\/browse,script-path=https://raw.githubusercontent.com/iidamie/mp/refs/heads/main/youtube/response.js,requires-body=1,max-size=0,binary-body-mode=0,timeout=90,script-update-interval=28800

[MITM]
hostname = %APPEND% youtubei.googleapis.com, youtubei.idamie.com